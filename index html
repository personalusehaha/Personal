    platforms:[[250,190,100,16],[420,150,90,16],[600,190,90,16],[800,140,120,16],[1050,190,100,16],[1250,150,100,16],[1500,190,140,16]],
    coins:[[270,160],[440,120],[620,160],[820,110],[840,110],[1070,160],[1270,120],[1520,160],[1560,160]],
    enemies:[{x:500,left:450,right:650,speed:1.6},{x:950,left:900,right:1150,speed:1.5},{x:1400,left:1350,right:1600,speed:1.8}],
    flagX:1820 },
  { width:2100, ground:230,
    platforms:[[220,190,80,16],[380,150,80,16],[540,190,80,16],[700,140,80,16],[860,190,80,16],[1020,150,80,16],[1180,190,80,16],[1400,150,120,16],[1650,190,140,16]],
    coins:[[240,160],[400,120],[560,160],[720,110],[880,160],[1040,120],[1200,160],[1420,120],[1440,120],[1670,160]],
    enemies:[{x:450,left:400,right:620,speed:1.8},{x:900,left:850,right:1100,speed:1.9},{x:1300,left:1250,right:1550,speed:2.0},{x:1750,left:1700,right:1980,speed:2.0}],
    flagX:2020 },
  { width:1400, ground:230, boss:true,
    platforms:[[300,190,100,16],[600,150,100,16],[900,190,100,16]],
    coins:[[320,160],[620,120],[920,160]],
    enemies:[],
    bossX:1150, flagX:1320 },
];
var marioState = null;
var marioKeys = { left:false, right:false, jump:false };
var marioRAF = null;
function marioStart(levelNum){
  pop(650);
  if(marioRAF) cancelAnimationFrame(marioRAF);
  var lvl = MARIO_LEVELS[levelNum-1];
  marioState = {
    level: levelNum, lvl: lvl,
    x:40, y:150, vx:0, vy:0, onGround:false, facing:1,
    coins:0, lives:3, camX:0, dead:false, won:false,
    coinsGot: new Array(lvl.coins.length).fill(false),
    enemies: lvl.enemies.map(function(e){ return {x:e.x, x0:e.x, alive:true, dir:1, left:e.left, right:e.right, speed:e.speed}; }),
    boss: lvl.boss ? { x: lvl.bossX, y:150, hp:3, alive:true, dir:-1, hitCooldown:0 } : null,
    flagReached:false,
  };
  document.getElementById('mario_result').innerText = '';
  marioLoop();
}
function marioSetupControls(){
  var canvas = document.getElementById('mario_canvas');
  if(!canvas || canvas._wired) return;
  canvas._wired = true;
  var L = document.getElementById('mario_left');
  var R = document.getElementById('mario_right');
  var J = document.getElementById('mario_jump');
  function bind(el, key){
    el.addEventListener('touchstart', function(e){ e.preventDefault(); marioKeys[key]=true; });
    el.addEventListener('touchend', function(e){ e.preventDefault(); marioKeys[key]=false; });
    el.addEventListener('mousedown', function(){ marioKeys[key]=true; });
    el.addEventListener('mouseup', function(){ marioKeys[key]=false; });
    el.addEventListener('mouseleave', function(){ marioKeys[key]=false; });
  }
  bind(L,'left'); bind(R,'right'); bind(J,'jump');
  document.addEventListener('keydown', function(e){
    if(e.key==='ArrowLeft') marioKeys.left=true;
    if(e.key==='ArrowRight') marioKeys.right=true;
    if(e.key===' '||e.key==='ArrowUp') marioKeys.jump=true;
  });
  document.addEventListener('keyup', function(e){
    if(e.key==='ArrowLeft') marioKeys.left=false;
    if(e.key==='ArrowRight') marioKeys.right=false;
    if(e.key===' '||e.key==='ArrowUp') marioKeys.jump=false;
  });
}
function marioLoop(){
  marioSetupControls();
  var s = marioState;
  var canvas = document.getElementById('mario_canvas');
  if(!canvas || !s) return;
  var ctx = canvas.getContext('2d');
  var lvl = s.lvl;
  var GRAV = 0.55, MOVE = 2.6, JUMPV = -10.5, GROUND_Y = lvl.ground;
  if(!s.dead && !s.won){
    if(marioKeys.left){ s.vx = -MOVE; s.facing=-1; }
    else if(marioKeys.right){ s.vx = MOVE; s.facing=1; }
    else s.vx = 0;
    if(marioKeys.jump && s.onGround){ s.vy = JUMPV; s.onGround=false; nesMove(); }
    s.vy += GRAV;
    s.x += s.vx; s.y += s.vy;
    s.onGround = false;
    if(s.y >= GROUND_Y-30){ s.y = GROUND_Y-30; s.vy=0; s.onGround=true; }
    lvl.platforms.forEach(function(p){
      var px=p[0], py=p[1], pw=p[2], ph=p[3];
      if(s.x+22>px && s.x<px+pw && s.y+30>py && s.y+30<py+ph+12 && s.vy>=0){
        s.y = py-30; s.vy=0; s.onGround=true;
      }
    });
    if(s.x<0) s.x=0;
    if(s.x>lvl.width-30) s.x=lvl.width-30;
    lvl.coins.forEach(function(c,i){
      if(!s.coinsGot[i] && Math.abs(s.x-c[0])<20 && Math.abs(s.y-c[1])<20){
        s.coinsGot[i]=true; s.coins++; nesBlip();
      }
    });
    s.enemies.forEach(function(en){
      if(!en.alive) return;
      en.x += en.dir*en.speed;
      if(en.x<en.left||en.x>en.right) en.dir*=-1;
      if(Math.abs(s.x-en.x)<20 && Math.abs(s.y-en.y)<24){
        if(s.vy>0 && s.y+30-en.y<18){
          en.alive=false; s.vy=-7; nesCapture();
        } else {
          marioDie();
        }
      }
    });
    if(s.boss && s.boss.alive){
      var b = s.boss;
      b.x += b.dir*1.3;
      if(b.x<lvl.width-350||b.x>lvl.width-60) b.dir*=-1;
      if(b.hitCooldown>0) b.hitCooldown--;
      if(Math.abs(s.x-b.x)<26 && Math.abs(s.y-b.y)<28){
        if(s.vy>0 && s.y+30-b.y<20){
          if(b.hitCooldown<=0){ b.hp--; b.hitCooldown=40; s.vy=-8; nesCapture();
            if(b.hp<=0){ b.alive=false; nesWin(); }
          }
        } else {
          marioDie();
        }
      }
    }
    if(s.x+20 >= lvl.flagX && (!lvl.boss || (s.boss && !s.boss.alive))){
      s.won = true;
      document.getElementById('mario_result').innerText = s.level<4 ? '🎉 Level ' + s.level + ' complete!' : '🏆 You beat the game!';
      nesWin();
      if(s.level<4) confettiBurst(document.getElementById('mario_wrap'));
      else confettiBurst(document.getElementById('mario_wrap'));
    }
    s.camX = Math.max(0, Math.min(s.x - 200, lvl.width-480));
  }
  ctx.clearRect(0,0,480,270);
  ctx.fillStyle = '#5C94FC'; ctx.fillRect(0,0,480,270);
  ctx.fillStyle = 'rgba(255,255,255,.85)';
  for(var i=0;i<4;i++){ var cx = (i*220 - s.camX*0.3) % 600 - 60; ctx.beginPath(); ctx.ellipse(cx,40+((i%2)*15),22,12,0,0,7); ctx.ellipse(cx+18,36+((i%2)*15),16,10,0,0,7); ctx.fill(); }
  ctx.save(); ctx.translate(-s.camX,0);
  ctx.fillStyle = '#8B5A2B'; ctx.fillRect(0, GROUND_Y, lvl.width, 40);
  ctx.fillStyle = '#5FBF3B'; ctx.fillRect(0, GROUND_Y, lvl.width, 8);
  lvl.platforms.forEach(function(p){ ctx.fillStyle='#C77B3E'; ctx.fillRect(p[0],p[1],p[2],p[3]); ctx.fillStyle='#5FBF3B'; ctx.fillRect(p[0],p[1],p[2],5); });
  lvl.coins.forEach(function(c,i){ if(!s.coinsGot[i]){ ctx.fillStyle='#FFD500'; ctx.beginPath(); ctx.arc(c[0]+3,c[1]+3,8,0,7); ctx.fill(); ctx.strokeStyle='#B8860B'; ctx.stroke(); } });
  s.enemies.forEach(function(en){ if(en.alive){ ctx.fillStyle='#8E44AD'; ctx.beginPath(); ctx.ellipse(en.x+8,en.y+18,14,12,0,0,7); ctx.fill(); ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(en.x+4,en.y+14,2.5,0,7); ctx.arc(en.x+14,en.y+14,2.5,0,7); ctx.fill(); } });
  if(s.boss && s.boss.alive){ var b=s.boss; ctx.fillStyle='#C0392B'; ctx.beginPath(); ctx.ellipse(b.x+10,b.y+16,26,22,0,0,7); ctx.fill(); ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(b.x+2,b.y+8,4,0,7); ctx.arc(b.x+20,b.y+8,4,0,7); ctx.fill(); }
  if(!lvl.boss || (s.boss && !s.boss.alive)){
    ctx.fillStyle='#888'; ctx.fillRect(lvl.flagX+14, GROUND_Y-90, 4, 90);
    ctx.fillStyle='#2ECC71'; ctx.beginPath(); ctx.moveTo(lvl.flagX+18,GROUND_Y-90); ctx.lineTo(lvl.flagX+44,GROUND_Y-78); ctx.lineTo(lvl.flagX+18,GROUND_Y-66); ctx.fill();
  }
  ctx.save();
  ctx.translate(s.x+11, s.y+15);
  if(s.facing<0) ctx.scale(-1,1);
  ctx.fillStyle = '#29E7CD';
  ctx.beginPath(); ctx.ellipse(0,0,13,15,0,0,7); ctx.fill();
  ctx.fillStyle = '#0E7490';
  ctx.beginPath(); ctx.ellipse(0,6,13,8,0,0,7); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.beginPath(); ctx.arc(5,-4,3.5,0,7); ctx.fill();
  ctx.fillStyle = '#111';
  ctx.beginPath(); ctx.arc(6,-4,1.6,0,7); ctx.fill();
  ctx.restore();
  ctx.restore();
  var hudText = 'Level ' + s.level + '/4  🪙 ' + s.coins + '  ❤️ ' + s.lives;
  if(s.boss) hudText = hudText + '  Boss HP: ' + s.boss.hp;
  document.getElementById('mario_hud').innerText = hudText;
  if(s.won){
    if(s.level<4){
      setTimeout(function(){ marioStart(s.level+1); }, 1400);
    }
  } else if(!s.dead){
    marioRAF = requestAnimationFrame(marioLoop);
  }
}
function marioDie(){
  var s = marioState;
  if(s.dead) return;
  s.dead = true; nesLose();
  s.lives--;
  document.getElementById('mario_result').innerText = s.lives>0 ? 'Ouch! Try again…' : 'Game over — restarting level 1.';
  setTimeout(function(){
    if(s.lives>0) marioStart(s.level);
    else marioStart(1);
  }, 900);
}
</script>
