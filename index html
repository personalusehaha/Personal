.card{position:relative; background:var(--surface); border:2px solid var(--card-border); border-radius:16px; padding:18px 14px; cursor:pointer; text-align:center; overflow:hidden; transition:transform .25s cubic-bezier(.34,1.56,.64,1), background .3s; box-shadow:0 4px 16px rgba(109,93,252,.1);}
.card::after{content:""; position:absolute; inset:-6px; z-index:-1; border-radius:20px; background:conic-gradient(from 0deg,var(--violet),var(--cyan),var(--pink),var(--violet)); filter:blur(16px); opacity:var(--card-glow-op); animation:neonspin 4s linear infinite;}
.card::before{content:""; position:absolute; inset:0; opacity:0; transition:.3s; background:linear-gradient(135deg,var(--violet),var(--cyan),var(--pink)); z-index:0;}
@keyframes borderflow{0%{background-position:0% 50%;}100%{background-position:300% 50%;}}
@keyframes shine{to{background-position:300% center;}}
.card:hover{transform:translateY(-6px) scale(1.05) rotate(-1deg); box-shadow:0 10px 26px rgba(109,93,252,.22);}
.card:hover::before{opacity:.1;}
.card:hover .ic{animation:wiggle .5s ease;}
@keyframes wiggle{0%,100%{transform:rotate(0);}25%{transform:rotate(-12deg) scale(1.15);}75%{transform:rotate(12deg) scale(1.15);}}
.card.active{animation:pop .35s ease;}
