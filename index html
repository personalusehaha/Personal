function handleMetaStoryUpload(e){
  const file = e.target.files[0];
  if(!file) return;
  const resultEl = document.getElementById('ms_result');
  const shareBtn = document.getElementById('ms_sharebtn');
  resultEl.innerText = ''; shareBtn.style.display='none';
  const W=3024, H=4032;
  const img = new Image();
  const reader = new FileReader();
  reader.onload = ev=>{
    img.onload = ()=>{
      const canvas = document.createElement('canvas');
      canvas.width=W; canvas.height=H;
      const ctx = canvas.getContext('2d');
      const scale = Math.max(W/img.width, H/img.height);
      const sw = W/scale, sh = H/scale;
      const sx = (img.width-sw)/2, sy = (img.height-sh)/2;
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, W, H);
      const preview = document.getElementById('ms_preview');
      preview.innerHTML = '';
      const previewImg = document.createElement('img');
      previewImg.src = canvas.toDataURL('image/jpeg', 0.95);
      previewImg.style.maxWidth = '100%';
      previewImg.style.borderRadius = '12px';
      preview.appendChild(previewImg);
      canvas.toBlob(blob=>{
        window._msBlob = blob;
        shareBtn.style.display = 'block';
        resultEl.innerText = '✅ Photo ready! Tap Share below.';
      }, 'image/jpeg', 0.95);
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}
function shareMetaStory(auto){
  const blob = window._msBlob;
  if(!blob) return;
  const file = new File([blob], 'meta-story.jpg', {type:'image/jpeg'});
