function runSearch(q){
  q = q.toLowerCase().trim();
  const ticker = document.querySelector('.ticker');
  const hero = document.getElementById('heroHeader');
  const main = document.getElementById('main');
  const results = document.getElementById('searchResults');
  if(!q){
    if(ticker) ticker.style.display='';
    hero.style.display='';
    main.style.display='';
    results.style.display='none';
    results.innerHTML='';
    return;
  }
  if(ticker) ticker.style.display='none';
  hero.style.display='none';
  main.style.display='none';
  results.style.display='block';
  const matches = allTools.filter(t=>t.name.toLowerCase().includes(q));
  results.innerHTML = matches.length ? '' : `<p style="text-align:center;color:var(--muted);padding:30px;">No tools found for "${q}"</p>`;
  if(matches.length){
    const grid = document.createElement('div');
    grid.className='grid';
    grid.style.maxWidth='1100px'; grid.style.margin='16px auto'; grid.style.padding='0 20px';
    matches.forEach(t=>grid.appendChild(makeCard(t)));
    results.appendChild(grid);
  }
}
