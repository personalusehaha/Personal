.modal label{display:block; font-size:12px; color:var(--muted); margin:14px 0 6px;}
.modal input[type=text], .modal input[type=number], .modal select, .modal textarea{width:100%; padding:10px 12px; border-radius:10px; border:1px solid var(--line); background:var(--input-bg); color:var(--text); font-size:14px; outline:none;}
.modal input[type=file]{width:100%; padding:10px; border-radius:10px; border:1px dashed var(--input-border); background:var(--input-bg); color:var(--muted);}
.btn{position:relative; margin-top:16px; width:100%; padding:14px; border:none; border-radius:14px; cursor:pointer; font-weight:700; font-size:14px; color:#fff; background:linear-gradient(135deg,var(--violet),var(--pink)); box-shadow:0 5px 0 var(--pink-dark), 0 8px 18px rgba(109,93,252,.3); transition:transform .12s, box-shadow .12s; display:block; text-align:center; text-decoration:none;}
.btn:hover{transform:translateY(-2px); box-shadow:0 7px 0 var(--pink-dark), 0 12px 22px rgba(109,93,252,.35);}
.btn:active{transform:translateY(3px); box-shadow:0 2px 0 var(--pink-dark);}
.btn.secondary{background:var(--surface); color:var(--violet-dark); box-shadow:0 5px 0 var(--line), 0 4px 10px rgba(109,93,252,.08); margin-top:8px;}
.result{margin-top:16px; font-size:13px; color:var(--cyan-dark); font-weight:600;}
.previewbox{margin-top:12px; text-align:center;}
.previewbox img, .previewbox canvas{max-width:100%; border-radius:10px; border:1px solid var(--line);}
.row2{display:flex; gap:10px;}
.row2>*{flex:1;}
.meterbar{height:10px; background:var(--badge-bg); border-radius:6px; overflow:hidden; margin-top:10px;}
.meterbar div{height:100%; width:0%; background:linear-gradient(90deg,var(--cyan),var(--pink)); transition:width .1s;}
.modetabs{display:flex; gap:8px; margin-top:10px;}
.modetabs button{flex:1; padding:8px; border-radius:10px; border:1px solid var(--line); background:var(--input-bg); color:var(--muted); cursor:pointer; font-size:13px;}
.modetabs button.on{background:linear-gradient(90deg,var(--violet),var(--pink)); color:#fff; border-color:transparent;}
footer{text-align:center; padding:30px; font-size:15px; position:relative; z-index:2;}
.footer-anim{font-family:'Fredoka',sans-serif; font-weight:600; font-size:16px; background:linear-gradient(90deg,var(--cyan-dark),var(--violet),var(--pink-dark),var(--cyan-dark)); background-size:300% auto; -webkit-background-clip:text; background-clip:text; color:transparent; animation:shine 5s linear infinite;}
.fh{display:inline-block; animation:heartbeat 1.2s ease-in-out infinite;}
</style>
