<style>
:root{
  --bg-grad:linear-gradient(160deg,#EEF2FF 0%,#FDF2FF 45%,#FFF7ED 100%);
  --surface:#FFFFFF; --surface2:#FFFFFF;
  --violet:#6D5DFC; --violet-dark:#4B3FD1;
  --cyan:#06B6D4; --cyan-dark:#0E7490;
  --pink:#EC4899; --pink-dark:#BE185D;
  --text:#211D3A; --muted:#6B7280; --line:#E7E3FB;
  --input-bg:#F9F8FF; --input-border:#C9C2F5; --badge-bg:#EDE9FE;
  --close-bg:#F3F1FF; --card-border:#fff; --overlay-bg:rgba(33,29,58,.35);
  --card-glow-op:.35;
}
[data-theme="dark"]{
  --bg-grad:#0B0B14;
  --surface:#14141f; --surface2:#1c1c2b;
  --violet:#7C5CFC; --violet-dark:#A796FF;
  --cyan:#29E7CD; --cyan-dark:#29E7CD;
  --pink:#FF4FA3; --pink-dark:#FF4FA3;
  --text:#F1F0FF; --muted:#8B88A8; --line:#2a2a3d;
  --input-bg:#0d0d18; --input-border:#3a3a55; --badge-bg:#1c1c2b;
  --close-bg:#161623; --card-border:transparent; --overlay-bg:rgba(5,5,10,.7);
  --card-glow-op:.6;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0; background:var(--bg-grad); background-attachment:fixed; color:var(--text); font-family:'Inter',sans-serif; overflow-x:hidden; transition:background .3s, color .3s;}
h1,h2,h3,.disp{font-family:'Fredoka',sans-serif;}
.blob{position:fixed; border-radius:50%; filter:blur(100px); opacity:.35; z-index:0; pointer-events:none; animation:float 14s ease-in-out infinite;}
.blob1{width:420px;height:420px;background:var(--violet);top:-120px;left:-100px;}
.blob2{width:380px;height:380px;background:var(--cyan);bottom:-140px;right:-80px;animation-delay:3s;}
.blob3{width:300px;height:300px;background:var(--pink);top:40%;left:60%;animation-delay:6s;}
@keyframes float{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(40px,-30px) scale(1.1);}}
.ticker{position:relative; z-index:5; width:100%; overflow:hidden; background:linear-gradient(90deg,var(--pink),var(--violet)); padding:12px 0; box-shadow:0 2px 12px rgba(109,93,252,.25);}
.ticker-track{display:flex; width:max-content; animation:scroll 18s linear infinite; white-space:nowrap;}
.ticker-track span{font-family:'Fredoka',sans-serif; font-weight:600; font-size:15px; letter-spacing:.04em; text-transform:uppercase; color:#fff; padding:0 14px;}
@keyframes scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}
.topbar{position:sticky; top:0; z-index:30; display:flex; justify-content:space-between; align-items:center; padding:14px 18px;}
.avatar-btn{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--violet),var(--pink));border:2px solid var(--surface);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:700;font-family:'Fredoka',sans-serif;font-size:16px;overflow:hidden;transition:.2s;box-shadow:0 3px 10px rgba(109,93,252,.4);animation:avatarpulse 2.4s ease-in-out infinite;}
.avatar-btn:hover{transform:scale(1.1) rotate(-6deg);}
.avatar-btn img{width:100%;height:100%;object-fit:cover;}
@keyframes avatarpulse{0%,100%{box-shadow:0 3px 10px rgba(109,93,252,.4);}50%{box-shadow:0 3px 20px rgba(109,93,252,.15);}}
.icon-btn{width:36px;height:36px;background:none;border:none;color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s;opacity:.75;}
.icon-btn:hover{opacity:1; color:var(--violet); transform:scale(1.1);}
#themeBtn{background:var(--text); color:var(--surface); border-radius:50%; opacity:1; font-size:15px; box-shadow:0 2px 8px rgba(0,0,0,.15); transition:background .3s, color .3s, transform .2s;}
#themeBtn:hover{color:var(--surface); transform:scale(1.12) rotate(15deg);}
.searchdrop{max-width:1100px;margin:0 auto;padding:0 18px;overflow:hidden;max-height:0;transition:max-height .25s ease;}
.searchdrop.open{max-height:70px;}
.searchdrop input{width:100%;padding:10px 14px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--text);font-size:14px;outline:none;margin:8px auto 4px;max-width:1100px;display:block;box-shadow:0 2px 8px rgba(109,93,252,.08);}
